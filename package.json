{
  "name": "@killmemory8/dsh-agents-md-presets",
  "version": "1.0.1",
  "description": "Named AGENTS.md presets for DSH: apply one per conversation, edit bodies in your own editor, and keep one rolling backup of the previous file.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/salvare013/dsh-agents-md-presets.git"
  },
  "homepage": "https://github.com/salvare013/dsh-agents-md-presets#readme",
  "bugs": {
    "url": "https://github.com/salvare013/dsh-agents-md-presets/issues"
  },
  "keywords": [
    "dsh",
    "dsh-plugin",
    "agents-md",
    "presets"
  ],
  "type": "module",
  "main": "lib/index.js",
  "scripts": {
    "test": "node test/store.test.mjs && node test/workspace.test.mjs && node test/editor.test.mjs && node test/host.test.mjs && node test/integration.test.mjs && node test/client.test.mjs",
    "check": "node --check lib/store.js && node --check lib/http.js && node --check lib/index.js && node --check lib/editor.js && node --check lib/client.js"
  },
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "lib",
    "locale",
    "icon.svg",
    "cordis.patch.yml",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.2.1-rc.5"
    },
    "client": {
      "inject": [
        "@deepseek-ai/dsh-client-ui-settings",
        "@deepseek-ai/dsh-client-ui-conversation"
      ],
      "platform": "web"
    }
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "*",
    "@deepseek-ai/schemastery": "*",
    "react": "*"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    },
    "react": {
      "optional": true
    }
  }
}